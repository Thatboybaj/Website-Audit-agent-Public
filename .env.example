# ---------- Branding ----------
PRODUCT_NAME=AuditPilot
AUDIT_BRAND=brightajiboye.com
AUDIT_SENDER=Bright

# ---------- Access ----------
# Owner key: unlocks everything with no limits (paste it in Settings → Owner key, or send Authorization: Bearer <key>)
AUDIT_API_TOKEN=
# Pro access codes you hand to paying customers, comma-separated (e.g. after they pay you manually)
PRO_CODES=

# ---------- Pricing shown in the app (no payment gateway yet) ----------
AEO_REPORT_PRICE=$29
PRO_MONTHLY_PRICE=$49/mo
PRICE_NOTE=Launch pricing
# When you add Lemon Squeezy / Paystack / Stripe later, put the checkout link here and a "Buy Pro" button appears
CHECKOUT_URL=

# ---------- Leads ----------
# Where "Request access" / "Get a quote" forms are sent (n8n, Make, Zapier, Supabase edge function…)
LEAD_WEBHOOK_URL=
CONTACT_WHATSAPP=
CONTACT_EMAIL=
CONTACT_BOOKING_URL=

# ---------- Data sources ----------
# Google PageSpeed Insights (free key: console.cloud.google.com → enable "PageSpeed Insights API")
PSI_API_KEY=
# Claude: AI copy review, AEO brand-clarity review, summaries, emails, FAQ drafts, AND the AI visibility test (web search)
ANTHROPIC_API_KEY=
AUDIT_MODEL=claude-sonnet-5-5
# Perplexity Sonar: second engine for the AI visibility test (optional)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# ---------- Limits ----------
DEMO_PER_HOUR=5
PRO_PER_DAY=200
VISIBILITY_PER_DAY=30
PSI_TIMEOUT=55
